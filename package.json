{
  "name": "clock-factory",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js && node server.js",
    "start": "node build.js && node server.js",
    "test": "node --test geometry.test.js hour-numerals.test.js hour-mesh.test.js hour-recess.test.js mechanism-box.test.js desk-stand.test.js export-3mf.test.js export-bambu.test.js svg-details.test.js svg-placement.test.js contours.test.js mesh-extrusion.test.js mesh-quality.test.js project.test.js print-readiness.test.js history.test.js mesh-analysis.test.js mesh-store.test.js hole-fit.test.js artwork-keys.test.js file-downloads.test.js settings-finder.test.js server.test.js desktop/assets.test.cjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "test:svg": "npm run build && electron tests/svg-import.electron.cjs",
    "test:svg-library": "npm run build && electron tests/svg-library.electron.cjs",
    "test:numerals-3mf": "npm run build && electron tests/numerals-3mf.electron.cjs",
    "test:svg-details": "npm run build && electron tests/svg-details.electron.cjs",
    "test:studio": "npm run build && electron tests/studio.electron.cjs",
    "test:bambu": "npm run build && electron tests/bambu-export.electron.cjs",
    "test:svg-backing": "npm run build && electron tests/svg-backing.electron.cjs",
    "test:hole-fit": "npm run build && electron tests/hole-fit.electron.cjs",
    "test:hours-recess": "npm run build && electron tests/hour-recess.electron.cjs",
    "test:mechanism-box": "npm run build && electron tests/mechanism-box.electron.cjs",
    "test:guided-studio": "npm run build && electron tests/guided-studio.electron.cjs",
    "test:desk-stand": "npm run build && electron tests/desk-stand.electron.cjs",
    "test:performance": "npm run build && electron tests/performance.electron.cjs",
    "test:workspace": "npm run build && electron tests/workspace.electron.cjs",
    "test:projects": "npm run build && electron tests/projects.electron.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "earcut": "3.2.4",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "polygon-clipping": "0.15.7",
    "three": "0.187.0"
  },
  "description": "Design custom 3D printable clocks from SVGs and ready-made designs.",
  "author": "Clock Factory",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.clockfactory.studio",
    "productName": "Clock Factory",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets.cjs",
      "desktop/icon.png",
      "index.html",
      "style.css",
      "studio.js",
      "export-worker.js",
      "mesh-view.js",
      "package.json",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clock Factory",
      "artifactName": "Clock-Factory-${version}-Windows-Setup.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "Clock-Factory-${version}-Windows-Portable.${ext}"
    }
  }
}
